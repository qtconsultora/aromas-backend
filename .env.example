# Copiá este archivo como ".env" (sin el .example) y completá los valores.
# El .env real NO se sube a git (ver .gitignore) porque tiene datos sensibles.

# Clave secreta de Django. Generá una nueva para producción, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-esto-en-produccion

# True en desarrollo local, False en producción (Render)
DJANGO_DEBUG=True

# Dominios permitidos, separados por coma. En producción va el dominio de Render
# y, cuando esté listo, el dominio de NIC.AR.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Igual que arriba pero con "https://" adelante -- lo pide Django para poder
# aceptar formularios (admin, confirmar pedido) en producción. Dejar vacío
# en desarrollo local.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Dejar vacío en desarrollo local (usa SQLite automáticamente).
# En Render se completa con la "Internal Database URL" que da el plan de Postgres,
# algo como: postgres://usuario:password@host/nombre_db
DATABASE_URL=
